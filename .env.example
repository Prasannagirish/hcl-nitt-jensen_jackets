# Copy this file to .env and fill in real values. .env is ignored by git; never commit it.
OPENAI_API_KEY=your-openai-key-here
PINECONE_API_KEY=your-pinecone-key-here

# Seed accounts for the app (Module 3). The app refuses to start if these are unset.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=choose-a-password
USER_LOGIN=researcher
USER_PASSWORD=choose-a-password
JWT_SECRET=change-me
