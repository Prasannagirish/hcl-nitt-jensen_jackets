# Copy to .env.local (ignored by git). Demo sign-in buttons appear only when these are set.
# Never put real passwords in source files; production builds leave these unset.
VITE_API_URL=http://127.0.0.1:8000
VITE_DEMO_ADMIN_LOGIN=admin
VITE_DEMO_ADMIN_PASSWORD=your-demo-admin-password
VITE_DEMO_USER_LOGIN=researcher
VITE_DEMO_USER_PASSWORD=your-demo-user-password
